# Copy to .env on the VPS. Replace placeholders; never commit the real file.
APP_NAME=TaranMidwife
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://midwife.example.com
APP_DOMAIN=midwife.example.com
TLS_EMAIL=admin@example.com
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=taranmidwife
DB_USERNAME=taranmidwife
DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
LOG_CHANNEL=stderr
LOG_LEVEL=warning
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
TARAN_REQUIRE_GPS=false
TARAN_AUTO_SCREEN=false
BACKUP_GPG_RECIPIENT=REPLACE_WITH_GPG_PUBLIC_KEY_FINGERPRINT
